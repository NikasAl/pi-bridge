[Unit]
Description=pi-bridge: WebSocket-мост к pi --mode rpc
After=network-online.target

[Service]
WorkingDirectory=%h/pi-bridge
Environment=PORT=8765
Environment=PI_BRIDGE_CWD=%h/projects/myproject
ExecStart=/usr/bin/node %h/pi-bridge/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
